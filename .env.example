# Example environment variables for local deployment.
# Copy this file to `.env` and fill in real secrets. Do NOT commit `.env`.

# IMAP credentials for fetch_incoming_mail
IMAP_HOST=imap.strato.de
IMAP_PORT=993
IMAP_USER=kontakt@example.org
IMAP_PASSWORD=

# Anleitung (admin handbook) password — can be a bcrypt hash ($2y$...) or plain text
ANLEITUNG_PASSWORD=
