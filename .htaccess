# ── Canonicalization: www → non-www + HTTPS ───────────────────────────────────
<IfModule mod_alias.c>
    # mod_alias catches hidden paths before a nested .htaccess can take over.
    RedirectMatch 403 ^/\.(?!well-known(?:/|$))
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block hidden files/directories while keeping the public security.txt standard path.
    RewriteRule ^[.]stage-security(?:/|$) - [F,L]
    RewriteRule ^[.]rollback-security-[0-9]+(?:/|$) - [F,L]
    RewriteRule ^\.(?!well-known(?:/|$)) - [F,L]

    # Block direct access to data/ directory
    RewriteRule ^data/ - [F,L]

    # Block direct access to inc/ directory (Funktionsbibliotheken, nie direkt aufgerufen)
    RewriteRule ^inc/ - [F,L]
    RewriteRule ^vendor/ - [F,L]

    # Block PHP file access in uploads
    RewriteRule ^images/.*\.php$ - [F,L]

    # 1) HTTP → HTTPS (zuerst — vor allen URL-Rewrites)
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # 2) www → non-www (YOUR-DOMAIN.TLD) — bitte Domain ersetzen!
    RewriteCond %{HTTP_HOST} ^www\.YOUR-DOMAIN\.TLD$ [NC]
    RewriteRule ^ https://YOUR-DOMAIN.TLD%{REQUEST_URI} [R=301,L]

    # Redirect old static legal pages to PHP
    RewriteRule ^impressum\.html$ /impressum.php [R=301,L]
    RewriteRule ^datenschutz\.html$ /datenschutz.php [R=301,L]

    # Clean URL: /vereinshaus.php → 301 → /vereinshaus (canonical, absolutes HTTPS)
    RewriteCond %{THE_REQUEST} \s/vereinshaus\.php[\s?] [NC]
    RewriteRule ^vereinshaus\.php$ https://YOUR-DOMAIN.TLD/vereinshaus [R=301,L]

    # Intern: /vereinshaus → vereinshaus.php (kein Browser-Redirect)
    RewriteRule ^vereinshaus$ /vereinshaus.php [L]

    # Veranstaltungs-Anmeldeseiten: /event/SLUG → event.php?slug=SLUG
    RewriteRule ^event/([a-z0-9-]+)/?$ event.php?slug=$1 [L,QSA]

    # Alt-Pfad /admin/* → 301 auf /intern/* (Code-Duplikat-Drift verhindern)
    RewriteRule ^admin/?$       https://YOUR-DOMAIN.TLD/intern/   [R=301,L]
    RewriteRule ^admin/(.+)$    https://YOUR-DOMAIN.TLD/intern/$1 [R=301,L]
</IfModule>

# ── GZIP Komprimierung ────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2

    # Bereits komprimierte Dateien nicht nochmals komprimieren
    SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|zip|gz|bz2|pdf)$ no-gzip dont-vary
</IfModule>

# ── Browser-Caching ───────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    # HTML — kurz halten
    ExpiresByType text/html                    "access plus 1 hour"

    # CSS + JS
    ExpiresByType text/css                     "access plus 1 year"
    ExpiresByType application/javascript       "access plus 1 year"
    ExpiresByType text/javascript              "access plus 1 year"

    # Bilder
    ExpiresByType image/jpeg                   "access plus 1 year"
    ExpiresByType image/png                    "access plus 1 year"
    ExpiresByType image/webp                   "access plus 1 year"
    ExpiresByType image/gif                    "access plus 1 year"
    ExpiresByType image/svg+xml               "access plus 1 year"
    ExpiresByType image/x-icon                "access plus 1 year"

    # Schriften
    ExpiresByType font/woff                    "access plus 1 year"
    ExpiresByType font/woff2                   "access plus 1 year"
    ExpiresByType application/font-woff        "access plus 1 year"
    ExpiresByType application/font-woff2       "access plus 1 year"

    # Dokumente
    ExpiresByType application/pdf              "access plus 1 month"
</IfModule>

# Cache-Control Header für statische Assets
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?|ttf|otf|eot|svg|ico|jpe?g|png|webp|gif)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.html?$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

# ── Security Headers ──────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "0"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
    # Content Security Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob:; connect-src 'self'; frame-src 'none'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self';"
    # ETags deaktivieren
    Header unset ETag
    # Server-Informationen ausblenden
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header unset Server
</IfModule>

FileETag None

# ── File type security ────────────────────────────────────────────────────────
<FilesMatch "\.(log|md|sh|env|sql|zip)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
# PHP per-directory settings must never be served as a file.
<Files ".user.ini">
    Require all denied
</Files>
# Alle .bak-Varianten blockieren (auch .bak-datum, .bak_datum etc.)
<FilesMatch "\.bak">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
# JSON blockieren — außer manifest.json (PWA)
<FilesMatch "^(?!manifest\.json$).*\.json$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ── Disable directory listing ─────────────────────────────────────────────────
Options -Indexes

# ── Server signature ──────────────────────────────────────────────────────────
ServerSignature Off
